---
// 訪客足跡地球儀：藍地黃虎旗（1895 臺灣民主國，公有領域）意象——虎馱地球。
// 圓形視窗、自動緩轉、拖曳旋轉、縮放（滾輪／按鈕／捏合）、hover 顯示國名與 30 天造訪次數。
// 資料：/data/visitor-globe.json；圖資：/vendor/countries-50m.json；d3、topojson-client 站內 vendor。
---

<div
  id="globe-card"
  class="relative mx-auto mt-6 w-full max-w-2xl overflow-hidden"
  style="aspect-ratio: 1 / 1.32;"
>
  <img src="/images/home/tiger-flame.png" alt="" class="pointer-events-none absolute right-[1%] top-[0%] z-[6] w-[18%]" loading="lazy" />
  <img src="/images/home/tiger-cloud-left.png" alt="" class="pointer-events-none absolute left-[1%] top-[13%] z-[8] w-[12%]" loading="lazy" />
  <img src="/images/home/tiger-cloud-left.png" alt="" class="pointer-events-none absolute bottom-[6%] left-[14%] z-[12] w-[12%]" loading="lazy" />
  <img src="/images/home/tiger-cloud-right.png" alt="" class="pointer-events-none absolute bottom-[0%] right-[27%] z-[12] w-[13%]" loading="lazy" />

  <div
    id="globe-wrap"
    class="absolute left-1/2 top-[38%] z-[5] w-[94%] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-full shadow-xl ring-4 ring-[#f3ead3]"
    style="aspect-ratio: 1;"
  >
    <canvas id="globe" class="block h-full w-full cursor-grab touch-none" aria-label="訪客來源地球儀（可拖曳旋轉、縮放）"></canvas>
  </div>

  <img
    src="/images/home/tiger.png"
    alt="藍地黃虎旗之黃虎"
    class="pointer-events-none absolute bottom-[1%] left-1/2 z-10 w-[100%]"
    style="transform: translateX(-54%) rotate(10deg) scaleY(0.68); transform-origin: bottom center;"
    loading="lazy"
  />

  <div id="globe-tip" class="pointer-events-none absolute z-20 hidden rounded bg-brand-800 px-2.5 py-1 text-sm text-white shadow"></div>
  <div class="absolute left-3 top-3 z-20 flex flex-col gap-1.5">
    <button id="globe-zin" type="button" aria-label="放大"
      class="h-8 w-8 rounded-sm border border-[#f3ead3]/60 bg-white/90 text-lg leading-none text-brand-800 shadow-sm transition hover:bg-white">＋</button>
    <button id="globe-zout" type="button" aria-label="縮小"
      class="h-8 w-8 rounded-sm border border-[#f3ead3]/60 bg-white/90 text-lg leading-none text-brand-800 shadow-sm transition hover:bg-white">－</button>
  </div>
</div>

<script is:inline src="/vendor/d3.v7.min.js"></script>
<script is:inline src="/vendor/topojson-client.min.js"></script>
<script is:inline>
(async function () {
  const canvas = document.getElementById("globe");
  if (!canvas || !window.d3 || !window.topojson) return;
  const card = document.getElementById("globe-card");
  const wrap = document.getElementById("globe-wrap");
  const tipEl = document.getElementById("globe-tip");
  let world, data, geo;
  try {
    [world, data, geo] = await Promise.all([
      fetch("/vendor/countries-50m.json").then((r) => r.json()),
      fetch("/data/visitor-globe.json").then((r) => r.json()),
      fetch("/data/visitor-regions.json").then((r) => (r.ok ? r.json() : null)).catch(() => null),
    ]);
  } catch { return; }
  const regionDots = geo?.regions ?? [];
  const cityDots = geo?.cities ?? [];
  const isEn = (document.documentElement.lang || "").toLowerCase().startsWith("en");
  const countries = topojson.feature(world, world.objects.countries).features;
  const borders = topojson.mesh(world, world.objects.countries, (a, b) => a !== b);
  const a2 = (f) => data.n3[String(f.id).padStart(3, "0")] ?? null;
  const bucket = (n) => (n >= 10000 ? "#1e3a5f" : n >= 1000 ? "#41608c" : n >= 100 ? "#7d97b8" : "#b9c8db");
  const fillOf = {};
  for (const f of countries) {
    const c = a2(f);
    const n = c ? data.counts[c] : null;
    fillOf[f.id] = n ? bucket(n) : "#e8edf3";
  }

  const ctx = canvas.getContext("2d");
  const proj = d3.geoOrthographic().clipAngle(90).rotate([-121, -23.5]);
  const path = d3.geoPath(proj, ctx);
  const sphere = { type: "Sphere" };
  const graticule = d3.geoGraticule10();
  let W = 0, dpr = 1;
  let zoom = 1.35; // 預設拉近，台灣居中
  const ZMIN = 0.95, ZMAX = 40;
  const applyScale = () => proj.scale((W / 2) * zoom);
  // 縮放層級決定圓點圖層：廣域＝國家著色，中距＝省州，近距＝縣市
  const dotsFor = () => (zoom >= 4.5 ? cityDots : zoom >= 2 ? regionDots : []);
  const dotR = (n) => Math.min(4 + 1.6 * Math.sqrt(n), 18);

  // 省州縣界（NE 10m admin-1，1.6 MB）：放大到 3 倍以上才首次載入。
  // 同時保留多邊形做命中測試（放大時反紅省州而非整國），bounds 先粗篩再 geoContains。
  const ADMIN_Z = 3;
  let admin1Mesh = null, admin1Features = null, admin1Loading = false;
  function ensureAdmin1() {
    if (admin1Mesh || admin1Loading || zoom < ADMIN_Z) return;
    admin1Loading = true;
    fetch("/vendor/admin1-10m.json")
      .then((r) => r.json())
      .then((topo) => {
        const obj = topo.objects[Object.keys(topo.objects)[0]];
        admin1Mesh = topojson.mesh(topo, obj, (a, b) => a !== b);
        admin1Features = topojson.feature(topo, obj).features;
        for (const f of admin1Features) f.__b = d3.geoBounds(f);
        render();
      })
      .catch(() => {})
      .finally(() => { admin1Loading = false; });
  }
  function admin1At(p) {
    if (!admin1Features) return null;
    const [lon, lat] = p;
    for (const f of admin1Features) {
      const b = f.__b;
      if (lat < b[0][1] - 0.1 || lat > b[1][1] + 0.1) continue;
      const inLon = b[0][0] <= b[1][0]
        ? lon >= b[0][0] - 0.1 && lon <= b[1][0] + 0.1
        : lon >= b[0][0] - 0.1 || lon <= b[1][0] + 0.1; // 跨越換日線
      if (inLon && d3.geoContains(f, p)) return f;
    }
    return null;
  }

  function resize() {
    W = wrap.clientWidth;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = W * dpr;
    canvas.height = W * dpr;
    proj.translate([W / 2, W / 2]);
    applyScale();
    render();
  }

  function setZoom(z) {
    zoom = Math.max(ZMIN, Math.min(ZMAX, z));
    applyScale();
    ensureAdmin1();
    render();
  }

  let hovered = null, hoveredDot = null, hoveredAdmin = null;
  // 目前可見的圓點（正面半球）與其螢幕座標，render 時更新、hover 命中用
  let visibleDots = [];
  function render() {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, W);
    ctx.fillStyle = "#f3f7fb"; ctx.fillRect(0, 0, W, W);
    ctx.beginPath(); path(graticule); ctx.strokeStyle = "#dde7f0"; ctx.lineWidth = 0.5; ctx.stroke();
    for (const f of countries) {
      ctx.beginPath(); path(f);
      ctx.fillStyle = f === hovered ? "#dc2626" : fillOf[f.id];
      ctx.fill();
    }
    if (hoveredAdmin) {
      ctx.beginPath(); path(hoveredAdmin);
      ctx.fillStyle = "#dc2626"; ctx.fill();
    }
    ctx.beginPath(); path(borders); ctx.strokeStyle = "#ffffff"; ctx.lineWidth = 0.6; ctx.stroke();
    if (zoom >= ADMIN_Z && admin1Mesh) {
      ctx.beginPath(); path(admin1Mesh);
      ctx.strokeStyle = "rgba(255,255,255,0.65)"; ctx.lineWidth = 0.4; ctx.stroke();
    }
    ctx.beginPath(); path(sphere); ctx.strokeStyle = "#cbd5e1"; ctx.lineWidth = 1; ctx.stroke();

    visibleDots = [];
    const r = proj.rotate();
    const center = [-r[0], -r[1]];
    for (const d of dotsFor()) {
      if (d3.geoDistance([d.lon, d.lat], center) > 1.45) continue;
      const pt = proj([d.lon, d.lat]);
      if (!pt) continue;
      const rad = dotR(d.n);
      visibleDots.push({ d, x: pt[0], y: pt[1], rad });
      ctx.beginPath();
      ctx.arc(pt[0], pt[1], rad, 0, 2 * Math.PI);
      ctx.fillStyle = d === hoveredDot ? "rgba(220,38,38,0.9)" : "rgba(220,38,38,0.55)";
      ctx.fill();
      ctx.strokeStyle = "#ffffff"; ctx.lineWidth = 1; ctx.stroke();
    }
  }

  // 滑鼠移入地球才緩轉（預設靜止、台灣正中；拖曳或指到國家時暫停；尊重減少動態偏好）
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let dragging = false, last = 0, mouseOver = false;
  canvas.addEventListener("pointerenter", () => { mouseOver = true; });
  d3.timer((t) => {
    if (reduced || !mouseOver || dragging || hovered || hoveredDot || hoveredAdmin) { last = t; return; }
    const dt = t - last; last = t;
    const r = proj.rotate();
    proj.rotate([r[0] + dt * 0.003, r[1], r[2]]);
    render();
  });

  // 縮放：滾輪、＋－按鈕、雙指捏合
  canvas.addEventListener("wheel", (e) => {
    e.preventDefault();
    setZoom(zoom * (e.deltaY < 0 ? 1.12 : 0.89));
  }, { passive: false });
  document.getElementById("globe-zin").addEventListener("click", () => setZoom(zoom * 1.25));
  document.getElementById("globe-zout").addEventListener("click", () => setZoom(zoom / 1.25));

  // tooltip 與命中測試（hover 與手機輕點共用）
  const showTipAt = (clientX, clientY, text) => {
    tipEl.textContent = text;
    const cardRect = card.getBoundingClientRect();
    tipEl.style.left = Math.min(clientX - cardRect.left + 14, cardRect.width - 130) + "px";
    tipEl.style.top = clientY - cardRect.top + 14 + "px";
    tipEl.classList.remove("hidden");
  };
  const fmt = (name, n) => (isEn ? `${name}: ${n.toLocaleString("en-US")}` : `${name}：${n.toLocaleString("en-US")}`);
  function pick(x, y) {
    // 圓點優先命中（省州／縣市統計）
    for (const v of visibleDots)
      if ((x - v.x) ** 2 + (y - v.y) ** 2 <= (v.rad + 3) ** 2)
        return { dot: v.d, text: fmt(v.d.name, v.d.n) };
    const p = proj.invert([x, y]);
    if (p && !isNaN(p[0])) {
      const rad = proj.scale();
      if ((x - W / 2) ** 2 + (y - W / 2) ** 2 <= rad * rad) {
        // 放大時命中省州多邊形；統計＝該省範圍內回報點的加總
        if (zoom >= ADMIN_Z) {
          const f = admin1At(p);
          if (f) {
            const label = `${f.properties.name}, ${f.properties.admin}`;
            let n = 0;
            for (const d of regionDots) if (d3.geoContains(f, [d.lon, d.lat])) n += d.n;
            return { admin: f, text: n ? fmt(label, n) : label };
          }
        }
        const hit = countries.find((f) => d3.geoContains(f, p));
        if (hit) {
          const c = a2(hit);
          const dict = (isEn ? data.names_en : data.names) || data.names;
          const name = (c && dict[c]) || hit.properties.name;
          const n = c ? data.counts[c] : null;
          return { country: hit, text: n ? fmt(name, n) : name };
        }
      }
    }
    return null;
  }

  // 拖曳旋轉＋雙指捏合；輕點（手機）＝顯示統計
  const pointers = new Map();
  let pinchDist = 0;
  let px = 0, py = 0, downX = 0, downY = 0, tapTimer = 0, tapActive = false;
  canvas.addEventListener("pointerdown", (e) => {
    pointers.set(e.pointerId, [e.clientX, e.clientY]);
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinchDist = Math.hypot(a[0] - b[0], a[1] - b[1]);
      dragging = false;
      return;
    }
    dragging = true; px = e.clientX; py = e.clientY; downX = e.clientX; downY = e.clientY;
    canvas.setPointerCapture(e.pointerId);
    canvas.style.cursor = "grabbing";
  });
  const endPointer = (e) => {
    const wasPinch = pointers.size >= 2;
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinchDist = 0;
    dragging = false; canvas.style.cursor = "grab";
    try { canvas.releasePointerCapture(e.pointerId); } catch {}
    // 輕點：按下到放開幾乎沒移動 → 顯示該處統計（觸控裝置沒有 hover）
    if (!wasPinch && e.type === "pointerup" && Math.hypot(e.clientX - downX, e.clientY - downY) < 8) {
      const rect = canvas.getBoundingClientRect();
      const res = pick(e.clientX - rect.left, e.clientY - rect.top);
      hoveredDot = res?.dot ?? null;
      hovered = res?.country ?? null;
      hoveredAdmin = res?.admin ?? null;
      render();
      clearTimeout(tapTimer);
      if (res) {
        showTipAt(e.clientX, e.clientY, res.text);
        tapActive = true;
        tapTimer = setTimeout(() => {
          tapActive = false;
          hovered = null; hoveredDot = null; hoveredAdmin = null; tipEl.classList.add("hidden"); render();
        }, 2600);
      } else { tapActive = false; tipEl.classList.add("hidden"); }
    }
  };
  canvas.addEventListener("pointerup", endPointer);
  canvas.addEventListener("pointercancel", endPointer);
  canvas.addEventListener("pointermove", (e) => {
    if (pointers.has(e.pointerId)) pointers.set(e.pointerId, [e.clientX, e.clientY]);
    if (pointers.size === 2 && pinchDist) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a[0] - b[0], a[1] - b[1]);
      if (d > 0) { setZoom(zoom * (d / pinchDist)); pinchDist = d; }
      return;
    }
    if (dragging) {
      const sens = 0.25 / zoom; // 拉近時降低靈敏度，避免一動就飛走
      const r = proj.rotate();
      proj.rotate([
        r[0] + (e.clientX - px) * sens,
        Math.max(-89, Math.min(89, r[1] - (e.clientY - py) * sens)),
        r[2],
      ]);
      px = e.clientX; py = e.clientY;
      hovered = null; hoveredDot = null; hoveredAdmin = null; tipEl.classList.add("hidden");
      render();
      return;
    }
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left, y = e.clientY - rect.top;
    const res = pick(x, y);
    const dotHit = res?.dot ?? null;
    const hit = res?.country ?? null;
    const adminHit = res?.admin ?? null;
    if (dotHit !== hoveredDot || hit !== hovered || adminHit !== hoveredAdmin) {
      hoveredDot = dotHit; hovered = hit; hoveredAdmin = adminHit; render();
    }
    if (res) showTipAt(e.clientX, e.clientY, res.text);
    else tipEl.classList.add("hidden");
  });
  canvas.addEventListener("pointerleave", () => {
    mouseOver = false;
    if (tapActive) return; // 觸控放開後瀏覽器會補發 pointerleave，別把剛輕點出的 tooltip 藏掉
    hovered = null; hoveredDot = null; hoveredAdmin = null; tipEl.classList.add("hidden"); render();
  });

  new ResizeObserver(resize).observe(wrap);
  resize();
})();
</script>
