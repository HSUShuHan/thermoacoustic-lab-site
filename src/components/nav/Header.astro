---
import {
  useTranslations,
  translatePath,
  type Lang,
  type UIKey,
} from "~/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = useTranslations(lang);

type NavLink = { href: string; key: UIKey };
type NavEntry = NavLink | { key: UIKey; children: NavLink[] };
const navItems: NavEntry[] = [
  { href: "/", key: "nav.home" },
  { href: "/research", key: "nav.research" },
  {
    key: "nav.output",
    children: [
      { href: "/publications", key: "nav.publications" },
      { href: "/talks", key: "nav.talks" },
      { href: "/media", key: "nav.media" },
    ],
  },
  { href: "/projects", key: "nav.projects" },
  { href: "/people", key: "nav.people" },
  { href: "/join-us", key: "nav.join" },
  { href: "/news", key: "nav.news" },
  { href: "/contact", key: "nav.contact" },
];

const prefix = lang === "en" ? "/en" : "";
const homeHref = lang === "en" ? "/en/" : "/";

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const fullHref = href === "/" ? homeHref : `${prefix}${href}`;
  if (fullHref === homeHref) return path === homeHref;
  return path.startsWith(fullHref);
};

const otherLang: Lang = lang === "en" ? "zh" : "en";
const switchHref = translatePath(path, otherLang);
const switchLabel = otherLang === "en" ? "EN" : "華";

const titleZh = "熱聲實驗室";
const titleEn = "Thermoacoustic Lab";
---

<header class="sticky top-0 z-50 border-b border-brand-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href={homeHref} class="group flex items-baseline gap-3">
      <span class="text-xl font-bold tracking-tight text-brand-800">
        {lang === "en" ? titleEn : titleZh}
      </span>
      <span
        class="hidden text-xs uppercase tracking-widest text-brand-400 sm:inline"
      >
        {lang === "en" ? titleZh : titleEn}
      </span>
    </a>
    <nav class="flex items-center gap-6">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          navItems.map((item) =>
            "children" in item ? (
              <li class="group relative" data-nav-group>
                <button
                  type="button"
                  aria-haspopup="true"
                  aria-expanded="false"
                  class:list={[
                    "inline-flex items-center gap-1 transition",
                    item.children.some((c) => isActive(c.href))
                      ? "border-b-2 border-accent-500 pb-0.5 font-medium text-brand-800"
                      : "text-gray-700 hover:text-brand-700",
                  ]}
                >
                  {t(item.key)}<span class="text-[0.65em] text-brand-400" aria-hidden="true">▼</span>
                </button>
                <div class="nav-dropdown invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-3 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                  <ul class="min-w-[8.5rem] rounded-md border border-brand-100 bg-white py-1.5 shadow-lg">
                    {item.children.map((c) => (
                      <li>
                        <a
                          href={`${prefix}${c.href}`}
                          class:list={[
                            "block px-4 py-1.5 transition",
                            isActive(c.href)
                              ? "font-medium text-brand-800"
                              : "text-gray-700 hover:bg-brand-50 hover:text-brand-800",
                          ]}
                        >
                          {t(c.key)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href === "/" ? homeHref : `${prefix}${item.href}`}
                  class:list={[
                    "transition",
                    isActive(item.href)
                      ? "border-b-2 border-accent-500 pb-0.5 font-medium text-brand-800"
                      : "text-gray-700 hover:text-brand-700",
                  ]}
                >
                  {t(item.key)}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a
        href={switchHref}
        class="rounded border border-brand-200 px-2 py-0.5 text-xs font-medium text-brand-600 transition hover:border-brand-800 hover:text-brand-900"
        aria-label={otherLang === "en" ? "Switch to English" : "切換至中文"}
      >
        {switchLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  [data-nav-group].nav-open .nav-dropdown {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  // 觸控裝置（iOS Safari 點按 button 不會取得 focus）需要點按切換下拉。
  document.querySelectorAll("[data-nav-group]").forEach((group) => {
    const btn = group.querySelector("button");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const open = group.classList.toggle("nav-open");
      btn.setAttribute("aria-expanded", String(open));
    });
  });
  document.addEventListener("click", (e) => {
    const target = e.target instanceof Node ? e.target : null;
    document.querySelectorAll("[data-nav-group].nav-open").forEach((group) => {
      if (!target || !group.contains(target)) {
        group.classList.remove("nav-open");
        group.querySelector("button")?.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>
