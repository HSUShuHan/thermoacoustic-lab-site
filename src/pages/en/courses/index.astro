---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";

const courses = (await getCollection("courses")).sort((a, b) => {
  if (a.data.semester !== b.data.semester)
    return b.data.semester.localeCompare(a.data.semester);
  return a.data.order - b.data.order;
});

const levelLabel: Record<string, string> = {
  undergrad: "Undergraduate",
  grad: "Graduate",
  both: "Undergraduate / Graduate",
};
---

<BaseLayout
  lang="en"
  title="Courses"
  description="Courses taught by Prof. Shu-Han Hsu: course rules and plans, grading, and the self-directed-learning lab assignment."
>
  <section class="py-8">
    <p class="text-xs uppercase tracking-[0.3em] text-brand-500">Courses</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-brand-900">Courses</h1>
    <div class="mt-3 h-1 w-16 bg-accent-500" aria-hidden="true"></div>
    <p class="mt-4 text-sm text-gray-500">
      Course rules and plans, grading, and lab assignment guidelines. Full course
      pages are currently in Chinese.
    </p>
  </section>

  <ul class="grid gap-4 border-t border-brand-100 pt-8 sm:grid-cols-2">
    {
      courses.map((c) => (
        <li>
          <a
            href={`/courses/${c.slug}/`}
            class="block h-full rounded border border-brand-200 bg-white p-5 transition hover:border-brand-800"
          >
            <p class="flex flex-wrap items-center gap-2 text-xs">
              <span class="font-mono text-gray-500">{c.data.semester}</span>
              <span class="rounded bg-brand-50 px-2 py-0.5 font-medium text-brand-700">
                {levelLabel[c.data.level]}
              </span>
            </p>
            <h2 class="mt-2 text-xl font-semibold text-brand-900">
              {c.data.title_en ?? c.data.title_zh}
            </h2>
            <p class="mt-0.5 text-sm text-brand-500">{c.data.title_zh}</p>
            {c.data.time_zh && (
              <p class="mt-2 text-sm text-gray-500">{c.data.time_zh}</p>
            )}
            <p class="mt-2 text-xs text-gray-500">
              Offered: {[...c.data.past_semesters, `${c.data.semester} (current)`].join(" · ")}
            </p>
            <p class="mt-3 text-xs text-gray-500">Course page in Chinese →</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
