---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";

const talks = (await getCollection("talks")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const typeLabel: Record<string, string> = {
  oral: "口頭發表",
  invited: "受邀演講",
  poster: "海報發表",
  seminar: "專題演講",
};

const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title="演講"
  description="熱聲實驗室的研討會發表與受邀演講，含可線上瀏覽的發表投影片。"
>
  <section class="py-8">
    <p class="text-xs uppercase tracking-[0.3em] text-brand-500">Talks</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-brand-900">演講</h1>
    <div class="mt-3 h-1 w-16 bg-accent-500" aria-hidden="true"></div>
    <p class="mt-4 text-sm text-gray-500">
      研討會發表與受邀演講的投影片，可直接在瀏覽器中觀看，部分附封存 DOI。
    </p>
  </section>

  <ul class="border-t border-brand-100">
    {
      talks.map((tk) => (
        <li class="flex flex-col gap-4 border-b border-brand-100 py-6 sm:flex-row sm:gap-6">
          {tk.data.cover && (
            <a
              href={tk.data.slides ?? undefined}
              class="block w-full shrink-0 sm:w-56"
            >
              <img
                src={tk.data.cover}
                alt={`${tk.data.title} 投影片標題頁`}
                class="aspect-video w-full rounded border border-brand-100 object-cover"
                loading="lazy"
              />
            </a>
          )}
          <div class="min-w-0">
            <p class="flex flex-wrap items-center gap-2 text-xs">
              <span class="font-mono text-gray-500">{fmtDate(tk.data.date)}</span>
              <span class="rounded bg-brand-50 px-2 py-0.5 font-medium text-brand-700">
                {typeLabel[tk.data.talk_type]}
              </span>
            </p>
            <h2 class="mt-1.5 font-medium leading-snug text-brand-900">
              {tk.data.title_zh ?? tk.data.title}
            </h2>
            {tk.data.authors.length > 0 && (
              <p class="mt-1 text-sm text-gray-700">{tk.data.authors.join("、")}</p>
            )}
            <p class="mt-0.5 text-sm text-gray-500">{tk.data.venue}</p>
            <div class="mt-2 flex flex-wrap gap-3 text-xs">
              {tk.data.slides && (
                <a
                  href={tk.data.slides}
                  class="rounded bg-brand-50 px-2 py-0.5 font-medium text-brand-700 hover:bg-brand-100"
                >
                  線上觀看投影片 ↗
                </a>
              )}
              {tk.data.pdf && (
                <a
                  href={tk.data.pdf}
                  target="_blank"
                  rel="noopener"
                  class="rounded bg-brand-50 px-2 py-0.5 font-medium text-brand-700 hover:bg-brand-100"
                >
                  PDF
                </a>
              )}
              {tk.data.doi && (
                <a
                  href={`https://doi.org/${tk.data.doi}`}
                  target="_blank"
                  rel="noopener"
                  class="text-accent-600 underline hover:text-accent-700"
                >
                  DOI: {tk.data.doi}
                </a>
              )}
              {tk.data.related_pub && (
                <a
                  href="/publications"
                  class="text-gray-500 underline hover:text-brand-700"
                >
                  相關論文
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
